# Server-Branding (öffentlich, wird an den Client ausgeliefert)
NUXT_PUBLIC_SERVER_NAME="Mein Minecraft Server"

# Logo und Favicon als Dateipfad auf dem Server (nur serverseitig, werden beim Start eingelesen; leer oder nicht lesbar = Standardlogo)
NUXT_SERVER_LOGO_FILE_PATH=
NUXT_SERVER_FAVICON_FILE_PATH=

# Twitch Helix API (nur serverseitig, niemals an den Client ausgeliefert)
NUXT_TWITCH_CLIENT_ID=
NUXT_TWITCH_CLIENT_SECRET=

# Dateisystem-Quellen (nur serverseitig)
NUXT_MINECRAFT_STATS_DIRECTORY_PATH=/path/to/world/stats
NUXT_MINECRAFT_ADVANCEMENTS_DIRECTORY_PATH=/path/to/world/advancements
NUXT_MINECRAFT_ONLINE_PLAYERS_FILE_PATH=/path/to/online-players.txt

# Cache-TTLs in Sekunden (optional, Defaults siehe nuxt.config.ts)
NUXT_TWITCH_LIVE_STATUS_CACHE_TTL_SECONDS=30
NUXT_MINECRAFT_ONLINE_STATUS_CACHE_TTL_SECONDS=15
NUXT_MINECRAFT_STATS_CACHE_TTL_SECONDS=300
